#: data/camera.metainfo.xml.in:10 data/io.elementary.camera.desktop.in:4
msgid "Camera"
msgstr "Wênekêş"

#: data/camera.metainfo.xml.in:11 data/io.elementary.camera.desktop.in:5
msgid "Take photos and videos with the camera"
msgstr "Bi wênekêş re wêne û vîdiyoyan bikşîne"

#: data/camera.metainfo.xml.in:13
msgid "Camera is a simple app to take photos with a webcam."
msgstr "Wênekêş sepanek bingehîn e ku mirov bi wênekêşa tevnê wêneyan dikşîne."

#: data/camera.metainfo.xml.in:35
msgid "elementary, Inc."
msgstr "elementary, Inc."

#: data/camera.metainfo.xml.in:43 data/camera.metainfo.xml.in:53
#: data/camera.metainfo.xml.in:66 data/camera.metainfo.xml.in:76
#: data/camera.metainfo.xml.in:86 data/camera.metainfo.xml.in:103
#: data/camera.metainfo.xml.in:122
msgid "Minor updates:"
msgstr "Rojanekirinên biçûk:"

#: data/camera.metainfo.xml.in:45
msgid "Open main menu with the keyboard shortcut F10"
msgstr "Menuya sereke bi kurterê ya kilîtdankê F10 veke"

#: data/camera.metainfo.xml.in:46 data/camera.metainfo.xml.in:55
#: data/camera.metainfo.xml.in:69 data/camera.metainfo.xml.in:79
#: data/camera.metainfo.xml.in:88 data/camera.metainfo.xml.in:105
#: data/camera.metainfo.xml.in:125
msgid "Updated translations"
msgstr "Wergerên rojanekirî"

#: data/camera.metainfo.xml.in:68
msgid "Update to elementary runtime 8"
msgstr "Bo elementary runtime 8 rojane bike"

#: data/camera.metainfo.xml.in:78
msgid "Update to elementary runtime 7.2"
msgstr "Bi elementary runtime 7.2 rojane bike"

#: data/camera.metainfo.xml.in:95 data/camera.metainfo.xml.in:112
msgid "New features:"
msgstr "Taybetmendiyên nû:"

#: data/camera.metainfo.xml.in:97
msgid "Support MJPEG cameras"
msgstr "Piştgiriya wênekêşên MJPEG"

#: data/camera.metainfo.xml.in:99 data/camera.metainfo.xml.in:116
msgid "Fixes:"
msgstr "Çareserkirin:"

#: data/camera.metainfo.xml.in:101
msgid "Show error in case no camera device is available"
msgstr "Ku amûra wênekêşiyê tune be, şaşetî nîşan bide"

#: data/camera.metainfo.xml.in:114
msgid "Take a photo or video on secondary-click"
msgstr "Bi tikandina-duyemîn wêne yan vîdiyoyekî bikşîne"

#: data/camera.metainfo.xml.in:118
msgid ""
"Ensure brightness, contrast, and mirror continue working after taking a photo"
msgstr ""
"Piştrast bike ku ronahî, kontrast û eynik piştî kişandina wêneyekê didomin"

#: data/camera.metainfo.xml.in:119
msgid "Wider hardware compatibility (e.g. StarBook Mk V)"
msgstr "Lihevhatina berfirehtir a reqalavê (b.m. StarBook Mk V)"

#: data/camera.metainfo.xml.in:120
msgid "Ensure photos saved properly"
msgstr "Piştrast bike ku wêne bi rêkûpêk têne tomarkirin"

#: data/camera.metainfo.xml.in:124
msgid "Improved performance and reliability"
msgstr "Performans û pêbaweriya başkirî"

#: data/io.elementary.camera.desktop.in:6
msgid "Photo Booth"
msgstr "Kabîna wêneyan"

#: data/io.elementary.camera.desktop.in:11
msgid "Photo;Video;Webcam;Camera;Booth;"
msgstr "Wêne;Vîdiyo;Wênekêşa tevnê;Wênekêş;Kabîn;"
